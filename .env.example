# Copy this file to .env and fill in values. NEVER commit the real .env file.
# All broker credentials are OPTIONAL and only needed for Paper/Live broker
# adapters that talk to a real venue. The research pipeline (run_research.py)
# does not require any of these.

# --- Korea broker (future live/paper connection, e.g. Korea Investment & Securities) ---
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=

# --- US broker (future live/paper connection, e.g. Alpaca) ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Safety switch. Must be explicitly and manually set to "true" by the user. ---
# The application also hardcodes this to false at the code level (see
# src/quant/config.py). This env var can never turn live trading on by
# itself; it is one of two locks that both must be opened by a human.
LIVE_TRADING=false
