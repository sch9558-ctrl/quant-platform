"""
data.go.kr (공공데이터포털) 금융위원회 주식시세정보_V2 API 기반 한국 시장 Provider.
날짜별 전종목 일괄 수집(Batch) 방식으로 단 1~2회 요청으로 시장 전체 시세 및 시가총액을 확보합니다.
"""

import os
import time
from datetime import datetime, timedelta
from typing import Dict, List, Optional
from urllib.parse import unquote

import pandas as pd
import requests


class DataGoKrProvider:
    """
    공공데이터포털 주식시세정보_V2 (getStockPriceInfo_V2) 데이터 제공자
    """
    BASE_URL = "https://apis.data.go.kr/1160100/service/GetStockSecuritiesInfoService/getStockPriceInfo_V2"

    def __init__(
        self,
        service_key: Optional[str] = None,
        cache_dir: str = "data/cache/kr",
        timeout: int = 25
    ):
        raw_key = service_key or os.getenv("DATA_GO_KR_SERVICE_KEY", "")
        # requests가 이중 인코딩하는 것을 방지하기 위해 반드시 디코딩된 순수 키 유지
        self.service_key = unquote(raw_key).strip()
        self.cache_dir = cache_dir
        self.timeout = timeout
        os.makedirs(self.cache_dir, exist_ok=True)

    def fetch_daily_snapshot(self, date_str: str) -> pd.DataFrame:
        """
        특정 영업일(YYYYMMDD)의 KOSPI/KOSDAQ 전 종목(약 2,800개) 시세를 1회 호출로 수집.
        로컬 캐시가 존재하면 API를 호출하지 않고 캐시에서 즉시 로드.
        """
        clean_date = date_str.replace("-", "")
        cache_path = os.path.join(self.cache_dir, f"kr_market_{clean_date}.parquet")

        # 1. 로컬 캐시 확인
        if os.path.exists(cache_path):
            try:
                return pd.read_parquet(cache_path)
            except Exception:
                pass

        if not self.service_key:
            raise ValueError(
                "DATA_GO_KR_SERVICE_KEY 가 설정되지 않았습니다. 환경변수 또는 Secret을 확인하세요."
            )

        # 2. API 파라미터 구성 (전 종목 일괄 요청: numOfRows=3500)
        params = {
            "serviceKey": self.service_key,
            "resultType": "json",
            "numOfRows": "3500",
            "pageNo": "1",
            "basDt": clean_date
        }

        response = requests.get(self.BASE_URL, params=params, timeout=self.timeout)

        # 3. XML 에러 방어
        if response.text.strip().startswith("<"):
            raise RuntimeError(
                f"data.go.kr API가 XML 에러를 반환했습니다:\n{response.text[:300]}"
            )

        data = response.json()
        body = data.get("response", {}).get("body", {})
        total_count = body.get("totalCount", 0)
        items_container = body.get("items", {})

        # 휴장일이거나 데이터가 없는 경우
        if total_count == 0 or not items_container:
            return pd.DataFrame()

        raw_items = items_container.get("item", [])
        if isinstance(raw_items, dict):
            raw_items = [raw_items]

        if not raw_items:
            return pd.DataFrame()

        df = pd.DataFrame(raw_items)

        # 4. 검증된 계약(Contract) 필드 매핑 및 타입 정규화
        column_mapping = {
            "basDt": "date",
            "srtnCd": "ticker",
            "itmsNm": "name",
            "mrktCtg": "market",
            "mkp": "open",
            "hipr": "high",
            "lopr": "low",
            "clpr": "close",
            "trqu": "volume",
            "trPrc": "turnover",
            "mrktTotAmt": "market_cap",
            "fltRt": "change_pct"
        }
        df = df.rename(columns=column_mapping)

        # 문자열을 부동소수점 및 정수로 변환
        numeric_cols = ["open", "high", "low", "close", "volume", "turnover", "market_cap", "change_pct"]
        for col in numeric_cols:
            if col in df.columns:
                df[col] = pd.to_numeric(df[col], errors="coerce").fillna(0.0)

        # 종목코드 6자리 정규화 (예: '005930', KOSPI/KOSDAQ 접미사 매핑)
        df["ticker"] = df["ticker"].astype(str).str.zfill(6)
        df["date"] = pd.to_datetime(df["date"], format="%Y%m%d")

        # 5. 로컬 캐시 저장
        try:
            df.to_parquet(cache_path, index=False)
        except Exception:
            pass

        return df

    def get_price_history_range(
        self,
        start_date: str,
        end_date: str,
        target_tickers: Optional[List[str]] = None
    ) -> Dict[str, pd.DataFrame]:
        """
        시작일부터 종료일까지 날짜별 스냅샷을 수집하여 종목별 시계열 DataFrame 딕셔너리로 재구성.
        반환: { '005930': pd.DataFrame(OHLCV Index=Date), ... }
        """
        start_dt = pd.to_datetime(start_date)
        end_dt = pd.to_datetime(end_date)

        daily_dfs = []
        curr = start_dt
        while curr <= end_dt:
            # 주말 제외
            if curr.weekday() < 5:
                date_str = curr.strftime("%Y%m%d")
                try:
                    day_df = self.fetch_daily_snapshot(date_str)
                    if not day_df.empty:
                        daily_dfs.append(day_df)
                except Exception as e:
                    print(f"[{date_str}] 데이터 수집 건너뜀: {e}")
                time.sleep(0.1)  # 정부 API 트래픽 보호
            curr += timedelta(days=1)

        if not daily_dfs:
            return {}

        full_df = pd.concat(daily_dfs, ignore_index=True)

        if target_tickers:
            clean_targets = [t.split(".")[0].zfill(6) for t in target_tickers]
            full_df = full_df[full_df["ticker"].isin(clean_targets)]

        # 종목별 시계열 딕셔너리로 분할
        ticker_dict = {}
        for ticker, group in full_df.groupby("ticker"):
            sorted_group = group.sort_values(by="date").set_index("date")
            ticker_dict[ticker] = sorted_group[["open", "high", "low", "close", "volume", "turnover", "market_cap"]]

        return ticker_dict