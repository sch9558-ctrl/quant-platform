.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# data & artifacts (regenerable / user-specific)
data/raw/*
data/processed/*
data/cache/*
data/db/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!data/db/.gitkeep

reports/*
!reports/.gitkeep
# The daily Markdown research report is a small, compact, aggregated
# summary (no raw price data) -- the GitHub Actions daily pipeline commits
# these so the report history is auditable in git, per the project's
# "compact validation history/metrics only, never raw data" auto-commit
# policy.
!reports/*.md
logs/*
!logs/.gitkeep

# secrets - NEVER commit
.env
*.key
secrets.yaml
config/broker_secrets.yaml

.DS_Store
