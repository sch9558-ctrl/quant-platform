.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# data & artifacts (regenerable / user-specific)
data/raw/*
data/processed/*
data/cache/*
data/db/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep
!data/db/.gitkeep

reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# secrets - NEVER commit
.env
*.key
secrets.yaml
config/broker_secrets.yaml

.DS_Store

# Private daily investment research is generated in CI and encrypted between jobs.
site/data/*.json
!site/data/.gitkeep
dashboard/data/*
!dashboard/data/.gitkeep
data/analyst_reports/*
!data/analyst_reports/.gitkeep
